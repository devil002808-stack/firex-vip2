            #firex-version { text-align: center; font-size: 11px; color: #777; margin-bottom: 9px; }
            .firex-btn { width: 100%; border: none; border-radius: 8px; padding: 9px 10px; margin-top: 7px; font-size: 13px; font-weight: 600; cursor: pointer; }
            #firex-start { background: #1b8f3c; color: #fff; }
