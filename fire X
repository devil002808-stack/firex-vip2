            #firex-fire { width: 52px; height: 52px; margin: 0 auto 10px; background: #000; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; cursor: pointer; position: relative; user-select: none; }
            #firex-status-dot { position: absolute; width: 12px; height: 12px; right: -1px; bottom: -1px; border-radius: 50%; background: #e53935; border: 2px solid #000; box-sizing: border-box; }
