            #firex-auto-panel.minimized #firex-fire { width: 62px; height: 62px; margin: 0; font-size: 30px; border-radius: 50%; }
            #firex-auto-panel.minimized #firex-status-dot { width: 12px; height: 12px; right: 2px; bottom: 2px; }
