// ==UserScript==
// @name         FireX
// @namespace    FireX
// @version      6.5
// @description  FireX Match Again automation with external UID authorization
// @match        *://*/*
// @grant        GM_xmlhttpRequest
// @connect      ://github.com
// @updateURL    https://githubusercontent.com
// @downloadURL  https://githubusercontent.com
// ==/UserScript==

(function () {
    'use strict';

    /* =========================================================
       SETTINGS
    ========================================================= */
    const GIST_ID = "ec184b4f5fd17e95db971dbb7811b1a4";
    const GITHUB_TOKEN = "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";
    const TARGET_WAIT = 1000;
    const TELEGRAM_URL = "https://t.me";
    const EXPIRY_PATTERN = /Countdown\s+to\s+Expiry/i;
    const FIREX_VERSION = "6.5";

    /* =========================================================
       STATE VARIABLES
    ========================================================= */
    let ALLOWED_REFERRAL_UIDS = new Set();
    let uidListLoaded = false;
    let uidListError = false;
    let automationRunning = false;
    let observer = null;
    let visibilityInterval = null;
    let targetTimer = null;
    let lastTargetButton = null;
    let uidCheckerInterval = null;
    let uidListRefreshInterval = null;
    let uidLoadRetryTimer = null;
    let firexDragging = false;
    let firexDragMoved = false;
    let firexStartX = 0, firexStartY = 0;
    let firexStartLeft = 0, firexStartTop = 0;
    const FIREX_DRAG_THRESHOLD = 5;

    /* =========================================================
       UID DETECTION LOGIC
    ========================================================= */
    function getPaywivoUID() {
        try {
            const raw = localStorage.getItem("memberId");
            if (raw) {
                const data = JSON.parse(raw);
                if (data && data.value !== undefined && data.value !== null) {
                    const value = String(data.value).trim();
                    if (/^\d+$/.test(value)) return value;
                }
            }
        } catch (e) {}

        try {
            const el = document.querySelector(".x-main-head p.id");
            if (el) {
                const match = el.textContent.match(/UID\s*:\s*(\d+)/);
                if (match && match[1]) return match[1];
            }
        } catch (e) {}

        return null;
    }

    function saveUIDList(uids) {
        try {
            localStorage.setItem("firex_uid_cache", JSON.stringify(Array.from(uids)));
        } catch (e) {}
    }

    function loadCachedUIDList() {
        try {
            const raw = localStorage.getItem("firex_uid_cache");
            if (!raw) return false;
            const parsed = JSON.parse(raw);
            if (!Array.isArray(parsed)) return false;
            const validUIDs = parsed.filter(uid => /^\d+$/.test(String(uid)));
            if (validUIDs.length === 0) return false;
            ALLOWED_REFERRAL_UIDS = new Set(validUIDs);
            uidListLoaded = true;
            uidListError = false;
            return true;
        } catch (e) { return false; }
    }

    /* =========================================================
       API AUTHORIZATION SERVICE
    ========================================================= */
    function loadUIDList(retryNumber = 0) {
        const url = `https://://github.com/gists/${GIST_ID}?t=${Date.now()}`;

        GM_xmlhttpRequest({
            method: "GET",
            url: url,
            headers: {
                "Authorization": `token ${GITHUB_TOKEN}`,
                "Accept": "application/vnd.github.v3+json"
            },
            timeout: 12000,
            onload: function (response) {
                if (!response || response.status < 200 || response.status >= 300) {
                    handleUIDLoadFailure(retryNumber);
                    return;
                }
                try {
                    const gistData = JSON.parse(response.responseText);
                    const fileKey = Object.keys(gistData.files); 
                    const content = gistData.files[fileKey].content;

                    const lines = String(content || "").split(/\r?\n/).map(x => x.trim());
                    const uids = lines.filter(x => /^\d+$/.test(x));

                    if (uids.length === 0) {
                        handleUIDLoadFailure(retryNumber);
                        return;
                    }

                    ALLOWED_REFERRAL_UIDS = new Set(uids);
                    uidListLoaded = true;
                    uidListError = false;
                    saveUIDList(ALLOWED_REFERRAL_UIDS);
                    updateAuthorizationUI();
                } catch (e) {
                    handleUIDLoadFailure(retryNumber);
                }
            },
            onerror: function () { handleUIDLoadFailure(retryNumber); },
            ontimeout: function () { handleUIDLoadFailure(retryNumber); }
        });
    }

    function handleUIDLoadFailure(retryNumber) {
        if (retryNumber < 3) {
            if (uidLoadRetryTimer) clearTimeout(uidLoadRetryTimer);
            uidLoadRetryTimer = setTimeout(function () {
                loadUIDList(retryNumber + 1);
            }, 3000);
            return;
        }
        if (uidListLoaded && ALLOWED_REFERRAL_UIDS.size > 0) {
            uidListError = false;
        } else {
            const cached = loadCachedUIDList();
            if (!cached) uidListError = true;
        }
        updateAuthorizationUI();
    }

    function checkUIDAuthorization() {
        if (!uidListLoaded) return { authorized: false, uid: getPaywivoUID(), status: "loading" };
        const uid = getPaywivoUID();
        if (!uid) return { authorized: false, uid: null, status: "no_uid" };
        if (ALLOWED_REFERRAL_UIDS.has(uid)) return { authorized: true, uid: uid, status: "matched" };
        return { authorized: false, uid: uid, status: "not_matched" };
    }

    function verifyCurrentUID() { updateAuthorizationUI(); }

    function startUIDChecker() {
        if (uidCheckerInterval) clearInterval(uidCheckerInterval);
        uidCheckerInterval = setInterval(function () {
            if (!automationRunning) verifyCurrentUID();
        }, 1000);
    }

    function playNotificationSound() {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const now = ctx.currentTime;
            const osc1 = ctx.createOscillator();
            const gain1 = ctx.createGain();
            osc1.type = "sine";
            osc1.frequency.setValueAtTime(1400, now);
            gain1.gain.setValueAtTime(0.20, now);
            gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.075);
            osc1.connect(gain1); gain1.connect(ctx.destination);
            osc1.start(now); osc1.stop(now + 0.075);
        } catch (e) {}
    }

    /* =========================================================
       UI COMPONENTS
    ========================================================= */
